// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int         @id @default(autoincrement())
  telegramId  String?     @unique
  username    String?
  role        String      @default("EMPLOYEE") // "OWNER" or "EMPLOYEE"
  clockToken      String?   @unique // secret held by the employee's linked phone
  enrollCode      String?   @unique // one-time code from the dashboard to link a phone
  enrollExpiresAt DateTime?
  createdAt   DateTime    @default(now())
  timeEntries TimeEntry[]
}

// Single row (id 1): where employees must be to clock in/out
model ShopSettings {
  id           Int      @id @default(1)
  lat          Float?
  lng          Float?
  wifiNetworks String[] // public network(s) of the shop Wi-Fi, see networkKey()
}

model Wash {
  id              Int      @id @default(autoincrement())
  originalMessage String
  parsedCar       String?
  parsedPrice     Float?
  parsedService   String?
  carType         String?
  addons          String?
  paymentMethod   String?
  senderName      String
  senderId        String
  createdAt       DateTime @default(now())
}

model BotSession {
  id              Int      @id @default(autoincrement())
  chatId          String   @unique
  step            String   @default("start")
  carType         String?
  service         String?
  basePrice       Float?
  addons          String?
  totalAddonPrice Float    @default(0)
  dealerId        Int?
  updatedAt       DateTime @updatedAt
}

model Dealer {
  id        Int           @id @default(autoincrement())
  name      String
  services  Json
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  batches   DealerBatch[]
  washes    DealerWash[]
}

model DealerBatch {
  id       Int          @id @default(autoincrement())
  dealerId Int
  dealer   Dealer       @relation(fields: [dealerId], references: [id])
  openedAt DateTime     @default(now())
  paidAt   DateTime?
  status   String       @default("OPEN")
  washes   DealerWash[]
}

model DealerWash {
  id          Int         @id @default(autoincrement())
  dealerId    Int
  dealer      Dealer      @relation(fields: [dealerId], references: [id])
  batchId     Int
  batch       DealerBatch @relation(fields: [batchId], references: [id])
  serviceName String
  price       Float
  comments    String?
  senderName  String
  senderId    String
  createdAt   DateTime    @default(now())
}

model InviteToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdBy String // telegramId of the owner
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TimeEntry {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  checkIn    DateTime
  checkOut   DateTime? // Null if currently checked in
  breakHours Float     @default(0)
  totalHours Float?
  checkInVia  String? // how presence was verified: "wifi" or "gps 42m" (null = manual/bot entry)
  checkOutVia String?
  createdAt  DateTime  @default(now())
}
